{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAndReadCloudFrontPolicies",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListDistributions",
        "cloudfront:ListVpcOrigins",
        "cloudfront:ListCachePolicies",
        "cloudfront:GetCachePolicy",
        "cloudfront:GetCachePolicyConfig",
        "cloudfront:ListOriginRequestPolicies",
        "cloudfront:GetOriginRequestPolicy",
        "cloudfront:GetOriginRequestPolicyConfig",
        "cloudfront:ListResponseHeadersPolicies",
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:GetResponseHeadersPolicyConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateDistributionsAndVpcOrigins",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateVpcOrigin"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateAndListOriginAccessControls",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:ListOriginAccessControls"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageAccountOriginAccessControls",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": "arn:aws:cloudfront::942466928325:origin-access-control/*"
    },
    {
      "Sid": "ManageAccountDistributions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::942466928325:distribution/*"
    },
    {
      "Sid": "ManageAccountVpcOrigins",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetVpcOrigin",
        "cloudfront:UpdateVpcOrigin",
        "cloudfront:DeleteVpcOrigin"
      ],
      "Resource": "arn:aws:cloudfront::942466928325:vpcorigin/*"
    },
    {
      "Sid": "TagDistributionsAndVpcOrigins",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": [
        "arn:aws:cloudfront::942466928325:distribution/*",
        "arn:aws:cloudfront::942466928325:vpcorigin/*"
      ]
    },
    {
      "Sid": "CreateVpcOriginServiceLinkedRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "arn:aws:iam::942466928325:role/aws-service-role/vpcorigin.cloudfront.amazonaws.com/AWSServiceRoleForCloudFrontVPCOrigin",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "vpcorigin.cloudfront.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadVpcOriginServiceLinkedRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": "arn:aws:iam::942466928325:role/aws-service-role/vpcorigin.cloudfront.amazonaws.com/AWSServiceRoleForCloudFrontVPCOrigin"
    },
    {
      "Sid": "ManageApiWebAcl",
      "Effect": "Allow",
      "Action": [
        "wafv2:CreateWebACL",
        "wafv2:GetWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:DeleteWebACL",
        "wafv2:TagResource",
        "wafv2:UntagResource",
        "wafv2:ListTagsForResource",
        "wafv2:GetLoggingConfiguration",
        "wafv2:DeleteLoggingConfiguration",
        "wafv2:GetRateBasedStatementManagedKeys"
      ],
      "Resource": "arn:aws:wafv2:us-east-1:942466928325:global/webacl/getddo-dev-api-waf/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:PrincipalAccount": "942466928325"
        }
      }
    },
    {
      "Sid": "ConfigureApiWebAclLogDestination",
      "Effect": "Allow",
      "Action": [
        "wafv2:PutLoggingConfiguration"
      ],
      "Resource": "arn:aws:wafv2:us-east-1:942466928325:global/webacl/getddo-dev-api-waf/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:PrincipalAccount": "942466928325"
        },
        "ArnEquals": {
          "wafv2:LogDestinationResource": "arn:aws:logs:us-east-1:942466928325:log-group:aws-waf-logs-getddo-dev-api"
        }
      }
    },
    {
      "Sid": "ListEdgeWebAcls",
      "Effect": "Allow",
      "Action": [
        "wafv2:ListWebACLs"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:PrincipalAccount": "942466928325"
        }
      }
    }
  ]
}
