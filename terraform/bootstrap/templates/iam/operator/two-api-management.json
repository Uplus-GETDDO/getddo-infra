{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageNamedSecondApiWithApprovedDocuments",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand",
        "ssm:StartSession"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:942466928325:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "ssm:resourceTag/Name": "getddo-dev-api-c"
        }
      }
    },
    {
      "Sid": "ManageProductionDeploymentLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::getddo-deploy-942466928325-ap-northeast-2/locks/container-deploy.json",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
