{
  "start": "-PT3H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 CPU (%)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "${instance_id}",
            {
              "label": "A"
            }
          ],
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "${instance_c_id}",
            {
              "label": "C"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 memory (%)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            "CWAgent",
            "mem_used_percent",
            "InstanceId",
            "${instance_id}",
            {
              "label": "A"
            }
          ],
          [
            "CWAgent",
            "mem_used_percent",
            "InstanceId",
            "${instance_c_id}",
            {
              "label": "C"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 root disk (%)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('{CWAgent,InstanceId,fstype,path} MetricName=\"disk_used_percent\" InstanceId=\"${instance_id}\" path=\"/\"', 'Average', 60)",
              "id": "disk_a",
              "label": "A root disk used (%)"
            }
          ],
          [
            {
              "expression": "SEARCH('{CWAgent,InstanceId,fstype,path} MetricName=\"disk_used_percent\" InstanceId=\"${instance_c_id}\" path=\"/\"', 'Average', 60)",
              "id": "disk_c",
              "label": "C root disk used (%)"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 CPU credit balance",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Minimum",
        "metrics": [
          [
            "AWS/EC2",
            "CPUCreditBalance",
            "InstanceId",
            "${instance_id}",
            {
              "label": "A"
            }
          ],
          [
            "AWS/EC2",
            "CPUCreditBalance",
            "InstanceId",
            "${instance_c_id}",
            {
              "label": "C"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 status check failed (0 = healthy)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "AWS/EC2",
            "StatusCheckFailed",
            "InstanceId",
            "${instance_id}",
            {
              "label": "A"
            }
          ],
          [
            "AWS/EC2",
            "StatusCheckFailed",
            "InstanceId",
            "${instance_c_id}",
            {
              "label": "C"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB requests / 5 min",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "RequestCount",
            "LoadBalancer",
            "${alb_suffix}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 18,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB 5xx / 5 min",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "HTTPCode_ELB_5XX_Count",
            "LoadBalancer",
            "${alb_suffix}"
          ],
          [
            "AWS/ApplicationELB",
            "HTTPCode_Target_5XX_Count",
            "LoadBalancer",
            "${alb_suffix}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 18,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB response time p95 (seconds)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "p95",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "TargetResponseTime",
            "LoadBalancer",
            "${alb_suffix}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 24,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB healthy / unhealthy targets (minimum healthy, maximum unhealthy)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "HealthyHostCount",
            "LoadBalancer",
            "${alb_suffix}",
            "TargetGroup",
            "${target_group_suffix}",
            {
              "stat": "Minimum"
            }
          ],
          [
            "AWS/ApplicationELB",
            "UnHealthyHostCount",
            "LoadBalancer",
            "${alb_suffix}",
            "TargetGroup",
            "${target_group_suffix}",
            {
              "stat": "Maximum"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 24,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RDS CPU (%)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/RDS",
            "CPUUtilization",
            "DBInstanceIdentifier",
            "${db_identifier}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 30,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RDS free memory (bytes)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Minimum",
        "metrics": [
          [
            "AWS/RDS",
            "FreeableMemory",
            "DBInstanceIdentifier",
            "${db_identifier}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 30,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RDS free storage (bytes)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Minimum",
        "metrics": [
          [
            "AWS/RDS",
            "FreeStorageSpace",
            "DBInstanceIdentifier",
            "${db_identifier}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 36,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RDS connections",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "AWS/RDS",
            "DatabaseConnections",
            "DBInstanceIdentifier",
            "${db_identifier}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 36,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis engine CPU / host CPU (%)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/ElastiCache",
            "EngineCPUUtilization",
            "CacheClusterId",
            "${redis_cluster_id}",
            "CacheNodeId",
            "0001"
          ],
          [
            "AWS/ElastiCache",
            "CPUUtilization",
            "CacheClusterId",
            "${redis_cluster_id}",
            "CacheNodeId",
            "0001"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 42,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis database memory usage (%)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/ElastiCache",
            "DatabaseMemoryUsagePercentage",
            "CacheClusterId",
            "${redis_cluster_id}",
            "CacheNodeId",
            "0001"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 42,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis evictions / 5 min",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/ElastiCache",
            "Evictions",
            "CacheClusterId",
            "${redis_cluster_id}",
            "CacheNodeId",
            "0001"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 48,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis connections",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "AWS/ElastiCache",
            "CurrConnections",
            "CacheClusterId",
            "${redis_cluster_id}",
            "CacheNodeId",
            "0001"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 54,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Hikari connections",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.active.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m0a",
              "label": "A hikaricp.connections.active.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.active.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m0c",
              "label": "C hikaricp.connections.active.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.idle.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m1a",
              "label": "A hikaricp.connections.idle.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.idle.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m1c",
              "label": "C hikaricp.connections.idle.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.max.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m2a",
              "label": "A hikaricp.connections.max.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.max.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m2c",
              "label": "C hikaricp.connections.max.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.pending.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m3a",
              "label": "A hikaricp.connections.pending.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.pending.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m3c",
              "label": "C hikaricp.connections.pending.value"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 54,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Hikari acquisition max (milliseconds)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.acquire.max\" environment=\"dev\" server=\"a\"', 'Maximum', 60)",
              "id": "m0a",
              "label": "A hikaricp.connections.acquire.max"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.acquire.max\" environment=\"dev\" server=\"c\"', 'Maximum', 60)",
              "id": "m0c",
              "label": "C hikaricp.connections.acquire.max"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 60,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Hikari timeouts / minute",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.timeout.count\" environment=\"dev\" server=\"a\"', 'Sum', 60)",
              "id": "m0a",
              "label": "A hikaricp.connections.timeout.count"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"hikaricp.connections.timeout.count\" environment=\"dev\" server=\"c\"', 'Sum', 60)",
              "id": "m0c",
              "label": "C hikaricp.connections.timeout.count"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 60,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Tomcat threads",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"tomcat.threads.busy.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m0a",
              "label": "A tomcat.threads.busy.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"tomcat.threads.busy.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m0c",
              "label": "C tomcat.threads.busy.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"tomcat.threads.current.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m1a",
              "label": "A tomcat.threads.current.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"tomcat.threads.current.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m1c",
              "label": "C tomcat.threads.current.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"tomcat.threads.config.max.value\" environment=\"dev\" server=\"a\"', 'Average', 60)",
              "id": "m2a",
              "label": "A tomcat.threads.config.max.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"tomcat.threads.config.max.value\" environment=\"dev\" server=\"c\"', 'Average', 60)",
              "id": "m2c",
              "label": "C tomcat.threads.config.max.value"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 66,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "JVM heap memory (bytes)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"jvm.memory.used.value\" environment=\"dev\" server=\"a\" area=\"heap\"', 'Average', 60)",
              "id": "m0a",
              "label": "A jvm.memory.used.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"jvm.memory.used.value\" environment=\"dev\" server=\"c\" area=\"heap\"', 'Average', 60)",
              "id": "m0c",
              "label": "C jvm.memory.used.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"jvm.memory.max.value\" environment=\"dev\" server=\"a\" area=\"heap\"', 'Average', 60)",
              "id": "m1a",
              "label": "A jvm.memory.max.value"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"jvm.memory.max.value\" environment=\"dev\" server=\"c\" area=\"heap\"', 'Average', 60)",
              "id": "m1c",
              "label": "C jvm.memory.max.value"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 66,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "JVM GC pause max (milliseconds)",
        "region": "${region}",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"jvm.gc.pause.max\" environment=\"dev\" server=\"a\"', 'Maximum', 60)",
              "id": "m0a",
              "label": "A jvm.gc.pause.max"
            }
          ],
          [
            {
              "expression": "SEARCH('Namespace=\"GETDDO/API\" MetricName=\"jvm.gc.pause.max\" environment=\"dev\" server=\"c\"', 'Maximum', 60)",
              "id": "m0c",
              "label": "C jvm.gc.pause.max"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 72,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "CloudFront WAF requests / minute",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/WAFV2",
            "AllowedRequests",
            "WebACL",
            "getddo-dev-api-waf",
            "Rule",
            "ALL"
          ],
          [
            "AWS/WAFV2",
            "BlockedRequests",
            "WebACL",
            "getddo-dev-api-waf",
            "Rule",
            "ApiIpRateLimit"
          ],
          [
            "AWS/WAFV2",
            "CountedRequests",
            "WebACL",
            "getddo-dev-api-waf",
            "Rule",
            "ApiIpRateLimit"
          ]
        ]
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 78,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "WAF AllowedRequests includes default-allowed traffic such as images and OPTIONS, not only API requests. CountedRequests counts rate-rule matches in Count mode. Missing points do not prove zero requests."
      }
    }
  ]
}
