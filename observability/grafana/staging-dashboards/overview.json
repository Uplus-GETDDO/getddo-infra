{
  "uid": "getddo-staging-overview",
  "title": "GETDDO Staging — load test",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "tags": [
    "staging",
    "loadtest"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "server",
        "type": "custom",
        "query": "a,c,locust",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 200,
      "title": "Locust users",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "locust_users{environment=\"staging\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 201,
      "title": "Locust RPS (rolling)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "locust_rps{environment=\"staging\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 202,
      "title": "Locust total requests / failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"locust_requests_total|locust_failures_total\",environment=\"staging\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 203,
      "title": "Locust failure ratio (1m, %)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(locust_failures_total{environment=\"staging\"}[1m]) / (rate(locust_requests_total{environment=\"staging\"}[1m]) > 0)",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 204,
      "title": "Locust latency p50 / p95 / p99 — rolling",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "locust_response_time_seconds{environment=\"staging\",scope=\"rolling\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 205,
      "title": "Locust latency p50 / p95 / p99 — cumulative",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "locust_response_time_seconds{environment=\"staging\",scope=\"cumulative\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 206,
      "title": "Locust master scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"staging-locust\",environment=\"staging\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 207,
      "title": "Locust data fresh (1=recent requests + workers)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "locust_data_fresh{environment=\"staging\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 208,
      "title": "Locust workers — expected / connected / fresh / healthy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"locust_workers_expected|locust_workers_connected|locust_workers_fresh|locust_workers_healthy\",environment=\"staging\"}",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 209,
      "title": "Business results / second (1m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario,method,result) (rate(locust_business_total{environment=\"staging\"}[1m]))",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 210,
      "title": "Business result counts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario,method,result) (locust_business_total{environment=\"staging\"})",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 211,
      "title": "API p99 — successful requests (1m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (server,le) (rate(http_server_requests_seconds_bucket{environment=\"staging\",server=~\"$server\",status=~\"[23]..\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[1m])))",
          "legendFormat": "{{__name__}} {{server}} {{quantile}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "5s"
    },
    {
      "id": 100,
      "title": "Google SRE · Four Golden Signals / 읽는 법",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "스테이징 전용 · Prometheus 5초 수집, rate 1분. 결측은 0이 아닙니다. Locust percentile은 master가 계산한 전체 요청 분포이며 worker 평균이 아닙니다. AWS 지표는 별도 Staging AWS resources 대시보드(원래 수집 주기)에서 확인합니다."
      }
    },
    {
      "id": 101,
      "title": "트래픽 · API 요청/초 (5분)",
      "description": "선택한 API 서버의 합계. 상태 검사·Swagger 제외. 0은 기록된 카운터의 증가가 없다는 뜻이며, —는 지표가 없는 상태입니다.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_requests_seconds_count{environment=\"staging\",server=~\"$server\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[1m]))",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 102,
      "title": "지연 · 성공 요청 p95 (5분)",
      "description": "성공(2xx/3xx) 요청을 합쳐 계산한 p95. 서버별 p95의 평균이 아닙니다. 성공 요청이 없으면 —이며 느린 오류는 아래 별도 그래프로 확인합니다.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 65,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"staging\",server=~\"$server\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\",status=~\"[23]..\"}[1m])))",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "—",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "—",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 103,
      "title": "오류 · 수집 정상 API의 5xx (%)",
      "description": "5xx / 전체 API 요청 × 100. 4xx·업무상 실패는 서버 오류로 세지 않습니다. 요청이 있고 5xx 시계열만 없을 때 0%; 요청이 없거나 미수집이면 —. 확정 SLO를 뜻하지 않습니다. 현재 up=1인 서버만 분자·분모에 같은 조건으로 포함합니다. 일부 서버가 수집 실패면 전체 서비스의 오류율이 아니므로 A/C 수집 상태를 함께 확인하세요.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 65,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(((sum by (server) (rate(http_server_requests_seconds_count{environment=\"staging\",server=~\"$server\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\",status=~\"5..\"}[1m])) or (0 * sum by (server) (rate(http_server_requests_seconds_count{environment=\"staging\",server=~\"$server\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[1m])))) and on(server) (up{job=\"staging-api\",environment=\"staging\",server=~\"$server\"} == 1))) / (sum((sum by (server) (rate(http_server_requests_seconds_count{environment=\"staging\",server=~\"$server\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[1m])) and on(server) (up{job=\"staging-api\",environment=\"staging\",server=~\"$server\"} == 1))) > 0)",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 104,
      "title": "포화도 · 가장 바쁜 DB 풀 (%)",
      "description": "선택한 API의 DB 풀 사용률 중 최대. DB 풀 지표만으로 전체 서비스의 여유를 보장하지 않습니다.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 65,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * hikaricp_connections_active{environment=\"staging\",server=~\"$server\"} / (hikaricp_connections_max{environment=\"staging\",server=~\"$server\"} > 0))",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 105,
      "title": "API A·C 수집 상태",
      "description": "1=지표 수집 성공, 0=수집 실패. 업무 API/DB의 정상 여부를 보장하는 상태 검사는 아닙니다. monitoring만 선택하면 API 시계열이 없습니다.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"staging-api\",environment=\"staging\",server=~\"$server\"}",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "수집 실패",
                  "color": "red"
                },
                "1": {
                  "text": "수집 정상",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 106,
      "title": "CPU · 가장 높은 사용률 (%)",
      "description": "선택한 호스트 중 최대 CPU 사용률. monitoring 호스트도 필터에 포함됩니다.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 70,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * (1 - avg by (server) (rate(node_cpu_seconds_total{environment=\"staging\",server=~\"$server\",mode=\"idle\"}[1m]))))",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 107,
      "title": "메모리 · 가장 높은 사용률 (%)",
      "description": "MemAvailable 기준 사용률. 페이지 캐시 전체를 사용 중 메모리로 오해하지 않도록 합니다.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 70,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
