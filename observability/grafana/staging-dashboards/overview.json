        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (server,le) (rate(http_server_requests_seconds_bucket{environment=\"staging\",server=~\"$server\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\",status=~\"[23]..\"}[1m])))",
