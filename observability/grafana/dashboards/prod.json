{
  "uid": "getddo-prod-overview",
  "title": "GETDDO Prod \u2014 API and hosts",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": [
    "prod"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "server",
        "type": "custom",
        "query": "A,C,monitoring",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health (missing series is not zero)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=\"prod\",server=~\"$server\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server,method,status) (rate(http_server_requests_seconds_count{environment=\"prod\",server=~\"$server\"}[2m]))",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (server,le) (rate(http_server_requests_seconds_bucket{environment=\"prod\",server=~\"$server\"}[5m])))",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(http_server_requests_seconds_count{environment=\"prod\",server=~\"$server\",status=~\"5..\"}[2m]))",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "JVM heap bytes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{environment=\"prod\",server=~\"$server\",area=\"heap\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "JVM GC pause seconds / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(jvm_gc_pause_seconds_sum{environment=\"prod\",server=~\"$server\"}[5m])",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Hikari active / pending",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"hikaricp_connections_active|hikaricp_connections_pending\",environment=\"prod\",server=~\"$server\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Tomcat busy / current threads",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"tomcat_threads_busy_threads|tomcat_threads_current_threads\",environment=\"prod\",server=~\"$server\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Host CPU busy ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (server) (rate(node_cpu_seconds_total{environment=\"prod\",server=~\"$server\",mode=\"idle\"}[2m]))",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Host available memory bytes",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{environment=\"prod\",server=~\"$server\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Host filesystem available bytes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{environment=\"prod\",server=~\"$server\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Monitoring disk used ratio (30 GiB; 20 GB blocks + WAL/head/Grafana headroom)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{environment=\"prod\",server=\"monitoring\",mountpoint=\"/srv/monitoring\"} / node_filesystem_size_bytes{environment=\"prod\",server=\"monitoring\",mountpoint=\"/srv/monitoring\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Prometheus head series",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_head_series{environment=\"prod\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Prometheus scrape samples",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_post_metric_relabeling{environment=\"prod\",server=~\"$server\"}",
          "legendFormat": "{{server}} {{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
