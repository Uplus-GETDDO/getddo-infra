[Unit]
Description=GETDDO Prod Prometheus and Grafana
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/monitoring

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/getddo-monitoring/observability
ExecStartPre=/opt/getddo-monitoring/scripts/monitoring-host.sh guard
ExecStartPre=/opt/getddo-monitoring/scripts/monitoring-host.sh secret
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop --timeout 60
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
