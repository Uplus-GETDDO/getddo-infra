[Unit]
Description=Apply validated Stage monitoring requests
After=network-online.target getddo-monitoring.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/getddo-monitoring/scripts/staging-monitoring.py watch
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/getddo-monitoring/observability/prometheus /opt/getddo-monitoring/observability/grafana/staging-dashboards
RuntimeDirectory=getddo-staging-monitoring
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
